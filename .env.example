# ----------------------------------------------------------------------------
# Public site URL — used for canonical tags, sitemap and Open Graph metadata.
#
# Its host also identifies the PLATFORM host for custom-domain routing: any
# incoming request whose Host is NOT this domain (nor localhost / *.vercel.app)
# is treated as a tenant's custom domain and rewritten by middleware.ts to that
# tenant's /[business] path. So set this to your real platform domain in prod.
# Connect a domain per-site on the admin business page (Pro+ plans); point its
# DNS at Vercel and add it under the Vercel project so TLS is issued.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# OPTIONAL: Supabase. Leave blank to use the bundled local data files in
# lib/data. When the URL + anon key are set, the data layer (lib/businesses.ts)
# loads *published* businesses from the `businesses` table instead.
# Apply the schema first: supabase/migrations/0001_init.sql.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for the admin/data WRITE path (create/update/publish/
# delete businesses) and webhook inserts. Bypasses RLS — never expose to the
# browser (note: no NEXT_PUBLIC_ prefix). Find it in Supabase → Project Settings
# → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# OPTIONAL: shared secret for the on-demand revalidation endpoint
# (POST /api/revalidate) used by Supabase DB webhooks / manual cache refreshes.
# ----------------------------------------------------------------------------
REVALIDATE_SECRET=

# ----------------------------------------------------------------------------
# OPTIONAL: where enquiry form submissions are forwarded. Leads are also
# persisted to the `leads` table when Supabase is configured. If neither this
# webhook nor Supabase is set, submissions are validated and logged server-side
# (still a working, runnable endpoint).
# ----------------------------------------------------------------------------
ENQUIRY_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# OPTIONAL: Resend email notifications on new leads (https://resend.com).
# If RESEND_API_KEY is unset, the lead is still persisted + webhooked; only the
# email is skipped. LEAD_NOTIFY_FROM must be a verified Resend sender.
# ----------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_NOTIFY_FROM="Leads <leads@yourdomain.com>"

# ----------------------------------------------------------------------------
# OPTIONAL: Stripe subscriptions (https://stripe.com). Leave blank to run
# without billing — the admin Billing page shows a "not configured" notice and
# the rest of the app is unaffected. No `stripe` npm package is used; calls go
# over the REST API and webhooks are verified with Node crypto.
#
#  - STRIPE_SECRET_KEY:     secret key (sk_test_… / sk_live_…).
#  - STRIPE_WEBHOOK_SECRET: signing secret for POST /api/stripe/webhook
#                           (Stripe Dashboard → Developers → Webhooks → whsec_…).
#  - STRIPE_PRICE_*:        the recurring Price id for each plan (price_…),
#                           created under Products in the Stripe Dashboard.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# ----------------------------------------------------------------------------
# OPTIONAL: SEO automation cron. The nightly job (see vercel.json) generates a
# fresh batch of locally-targeted blog articles for every published business at
# /api/cron/seo. It requires Supabase (service role) to write posts.
#
# CRON_SECRET gates the endpoint: Vercel Cron sends it as a Bearer token, and you
# can trigger a run manually with ?secret=<CRON_SECRET>. Generate a long random
# value. Without it the endpoint returns 500 (disabled). Server-only — no
# NEXT_PUBLIC_ prefix. The admin "SEO & Blog" page can also trigger generation
# for the signed-in org without this secret. CRON_SECRET also gates the agent job
# worker at /api/jobs/tick (runs every minute; see vercel.json).
# ----------------------------------------------------------------------------
CRON_SECRET=

# ----------------------------------------------------------------------------
# OPTIONAL: AI layer (Agency OS). Powers the AI agents (lib/ai, lib/agents).
# Without ANTHROPIC_API_KEY the AI client runs in STUB mode — calls return
# clearly-marked placeholder text at zero cost, so the app stays runnable, but no
# real generation happens. Server-only — no NEXT_PUBLIC_ prefix.
#
#  - ANTHROPIC_API_KEY: your Anthropic API key (sk-ant-…).
#  - ANTHROPIC_MODEL_{FAST,SMART,MAX}: optional model-id overrides for the three
#    routing tiers (defaults: Haiku / Sonnet / Opus — see lib/ai/models.ts).
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_SMART=
ANTHROPIC_MODEL_MAX=

# ----------------------------------------------------------------------------
# OPTIONAL: AI spend caps (GBP pence). Org-wide defaults enforced by the agent
# runner before each run; 0 / unset = uncapped. Per-agent overrides live in the
# agent_settings table (set from the Agent Control Centre). Recommended in prod
# so an autonomous loop can never run up a surprise bill.
# ----------------------------------------------------------------------------
AI_DAILY_CAP_PENCE=
AI_MONTHLY_CAP_PENCE=

# ----------------------------------------------------------------------------
# OPTIONAL: Goal Engine / empire loop (5-hour setup, then autonomous).
#
#  - RESEND_INBOUND_SECRET: gates POST /api/webhooks/resend — the Resend Inbound
#    webhook that captures prospect REPLIES (records the inbound message and
#    advances the prospect to `responded`, stopping follow-ups to whoever already
#    answered). Configure in Resend → Inbound: route replies to
#    https://YOUR-DOMAIN/api/webhooks/resend?secret=<this value>. Generate a long
#    random value. Server-only — no NEXT_PUBLIC_ prefix.
#
#  - OPERATOR_NOTIFY_EMAIL: where the weekly empire briefing email lands (goal
#    progress, loop activity, blockers). Sent once/week by the automation tick
#    when Resend is configured; skipped silently otherwise. Requires migration
#    0016_loop_state.sql to be applied (digest gating + weekly snapshots).
# ----------------------------------------------------------------------------

# SCHEDULING NOTE: vercel.json runs /api/automation/tick daily at 06:00 UTC
# (Vercel Hobby allows one cron per day). For a faster loop on Hobby, register a
# free external scheduler (e.g. cron-job.org) hitting
#   https://YOUR-DOMAIN/api/automation/tick?secret=<CRON_SECRET>
# every 1–6 hours — it's idempotent and bounded per run.

